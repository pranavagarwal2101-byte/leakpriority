# Environment Configuration Template for LeakPriority
# Duplicate this file to .env.local and populate the values if integrating with AWS.

# Base API URL for backend calls (API Gateway endpoint)
# Format: https://{restapi_id}.execute-api.{region}.amazonaws.com/{stage}
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/dev
# Leave empty or omitted to use local in-browser persistence (localStorage mock mode)
VITE_API_URL=
